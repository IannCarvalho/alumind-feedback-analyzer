# Configurações do Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=sua-chave-secreta-aqui

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Senha de acesso ao dashboard (rotas web). Se vazia, o dashboard
# fica aberto sem login (útil em desenvolvimento). Defina em produção.
DASHBOARD_PASSWORD=

# Configurações do Banco de Dados
DATABASE_URL=postgresql://usuario:senha@localhost/feedlens

# Configurações da OpenAI
OPENAI_API_KEY=sua-chave-api-da-openai
OPENAI_MODEL=gpt-4o-mini
# Timeout (s) e nº de retries da chamada à LLM
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2

# Configurações de Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-de-app
EMAIL_USE_TLS=True
EMAIL_RECIPIENTS=stakeholder1@feedlens.app,stakeholder2@feedlens.app
# Timeout (s) da conexão SMTP e URL pública do painel (link no e-mail)
EMAIL_TIMEOUT=30
APP_BASE_URL=http://localhost:5000

# Agendador do resumo semanal (segunda às 8h). Ligue em UM processo só: com
# mais de um worker, deixe false no web e rode `python -m app.scheduling`.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Rate limiting da API de ingestão (POST /api/feedbacks)
RATELIMIT_ENABLED=True
# memory:// serve para 1 processo; use redis://host:6379 com múltiplos workers
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_INGEST=30 per minute

# CORS: origens permitidas para /api/* (separadas por vírgula). * = qualquer origem.
CORS_ORIGINS=*
