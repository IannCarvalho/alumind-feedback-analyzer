# Configurações do Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=sua-chave-secreta-aqui

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Senha de acesso ao dashboard (rotas web). Se vazia, o dashboard
# fica aberto sem login (útil em desenvolvimento). Defina em produção.
DASHBOARD_PASSWORD=

# Configurações do Banco de Dados
DATABASE_URL=postgresql://usuario:senha@localhost/feedlens

# Configurações da OpenAI
OPENAI_API_KEY=sua-chave-api-da-openai
OPENAI_MODEL=gpt-4o-mini

# Configurações de Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-de-app
EMAIL_USE_TLS=True
EMAIL_RECIPIENTS=stakeholder1@feedlens.app,stakeholder2@feedlens.app

# Rate limiting da API de ingestão (POST /api/feedbacks)
RATELIMIT_ENABLED=True
# memory:// serve para 1 processo; use redis://host:6379 com múltiplos workers
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_INGEST=30 per minute
